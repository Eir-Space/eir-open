FROM node:20-bookworm-slim AS deps

ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app/apps/skills-eir-space

COPY apps/skills-eir-space/package.json apps/skills-eir-space/package-lock.json ./

RUN npm ci

FROM node:20-bookworm-slim AS build

ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

COPY --from=deps /app/apps/skills-eir-space/node_modules ./apps/skills-eir-space/node_modules
COPY apps/skills-eir-space ./apps/skills-eir-space
COPY skills ./skills

WORKDIR /app/apps/skills-eir-space

RUN npm run build && npm prune --omit=dev

FROM node:20-bookworm-slim AS runner

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

WORKDIR /app

COPY --from=build /app/apps/skills-eir-space ./apps/skills-eir-space
COPY --from=build /app/skills ./skills

WORKDIR /app/apps/skills-eir-space

EXPOSE 3000

CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0", "--port", "3000"]
