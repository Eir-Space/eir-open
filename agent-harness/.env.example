# Integration test configuration — copy to .env and fill in values.
# Unit tests (npm test) do not require any env vars.

# LLM API key (works with any OpenAI-compatible provider: OpenAI, Groq, Together, Mistral, Ollama, etc.)
LLM_API_KEY=
# Base URL (e.g., https://api.openai.com/v1, https://api.groq.com/openai/v1, http://localhost:11434/v1)
LLM_BASE_URL=
# Model ID (e.g., gpt-4o-mini, llama-3.1-8b, mistral-large-latest)
LLM_MODEL=
