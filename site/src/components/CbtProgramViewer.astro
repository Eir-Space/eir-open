---
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

interface TranslationMeta {
  lang?: string;
  status?: string;
  completion?: number;
  path?: string;
}

interface ProgramJson {
  id?: string;
  version?: string;
  status?: string;
  condition?: { name?: string };
  defaultLanguage?: string;
  content?: { moduleCount?: number };
  translations?: TranslationMeta[];
  lineage?: {
    aiCreated?: boolean;
    humanCreated?: boolean;
    humanReviewed?: boolean;
    healthcareExpertVerified?: boolean;
  };
}

interface ProgramRow {
  id: string;
  condition: string;
  version: string;
  status: string;
  moduleCount: number | string;
  defaultLanguage: string;
  languages: string[];
  translationPaths: Record<string, string>;
  translationSummary: string;
  lineage: string[];
  githubUrl: string;
  searchText: string;
}

const componentDir = path.dirname(fileURLToPath(import.meta.url));
const repoRoot = path.resolve(componentDir, '../../..');
const programsDir = path.join(repoRoot, 'skills', 'cbt-programs', 'data', 'programs');

const lineageLabels = [
  ['aiCreated', 'AI-created'],
  ['humanCreated', 'Human-created'],
  ['humanReviewed', 'Human-reviewed'],
  ['healthcareExpertVerified', 'Expert-verified'],
] as const;

const rows: ProgramRow[] = fs
  .readdirSync(programsDir, { withFileTypes: true })
  .filter((entry) => entry.isDirectory())
  .map((entry) => {
    const programPath = path.join(programsDir, entry.name, 'program.json');
    if (!fs.existsSync(programPath)) return null;

    const raw = fs.readFileSync(programPath, 'utf8');
    const program = JSON.parse(raw) as ProgramJson;

    const id = program.id || entry.name;
    const condition = program.condition?.name || 'Unknown condition';
    const version = program.version || '0.0.0';
    const status = program.status || 'draft';
    const moduleCount =
      typeof program.content?.moduleCount === 'number' ? program.content.moduleCount : '?';
    const translations = Array.isArray(program.translations) ? program.translations : [];

    const translationPaths: Record<string, string> = {};
    translations.forEach((t) => {
      const lang = (t.lang || '').trim();
      if (!lang) return;
      translationPaths[lang] = t.path || `locales/${lang}.json`;
    });

    const languages = (
      translations.map((t) => (t.lang || '').trim()).filter(Boolean) as string[]
    ).sort();
    if (languages.length === 0 && program.defaultLanguage) languages.push(program.defaultLanguage);
    const defaultLanguage = program.defaultLanguage || languages[0] || 'en';
    if (!translationPaths[defaultLanguage]) {
      translationPaths[defaultLanguage] = `locales/${defaultLanguage}.json`;
    }

    const translationSummary =
      translations
        .map((t) => {
          const lang = t.lang || 'unknown';
          const review = t.status || 'unknown';
          const completion =
            typeof t.completion === 'number' ? ` ${Math.max(0, Math.min(100, t.completion))}%` : '';
          return `${lang}:${review}${completion}`;
        })
        .join(' | ') || 'No translation metadata';

    const lineage = lineageLabels
      .filter(([key]) => Boolean(program.lineage?.[key]))
      .map(([, label]) => label);

    const githubUrl =
      `https://github.com/eir-space/eir-open/tree/main/` +
      `skills/cbt-programs/data/programs/${id}`;

    const searchText = [
      id,
      condition,
      status,
      version,
      languages.join(' '),
      translationSummary,
      lineage.join(' '),
    ]
      .join(' ')
      .toLowerCase();

    return {
      id,
      condition,
      version,
      status,
      moduleCount,
      defaultLanguage,
      languages,
      translationPaths,
      translationSummary,
      lineage,
      githubUrl,
      searchText,
    };
  })
  .filter((row): row is ProgramRow => Boolean(row))
  .sort((a, b) => a.id.localeCompare(b.id));

const allLanguages = Array.from(new Set(rows.flatMap((row) => row.languages))).sort();
const swedishReadyCount = rows.filter((row) => row.languages.includes('sv')).length;
const expertVerifiedCount = rows.filter((row) => row.lineage.includes('Expert-verified')).length;
---

<div class="cbt-viewer not-content" data-cbt-program-viewer>
  <div class="cbt-viewer-hero">
    <div class="cbt-viewer-stat">
      <span class="cbt-viewer-stat-value">{rows.length}</span>
      <span class="cbt-viewer-stat-label">Total programs</span>
    </div>
    <div class="cbt-viewer-stat">
      <span class="cbt-viewer-stat-value">{swedishReadyCount}</span>
      <span class="cbt-viewer-stat-label">With Swedish locale</span>
    </div>
    <div class="cbt-viewer-stat">
      <span class="cbt-viewer-stat-value">{expertVerifiedCount}</span>
      <span class="cbt-viewer-stat-label">Expert-verified lineage</span>
    </div>
  </div>

  <div class="cbt-viewer-toolbar">
    <label class="cbt-viewer-field">
      <span>Search</span>
      <input
        type="search"
        placeholder="Program, condition, language, lineage..."
        aria-label="Search CBT programs"
        data-role="search"
      />
    </label>
    <label class="cbt-viewer-field cbt-viewer-field-lang">
      <span>Language</span>
      <select aria-label="Filter by language" data-role="language">
        <option value="all">All languages</option>
        {allLanguages.map((lang) => <option value={lang}>{lang}</option>)}
      </select>
    </label>
  </div>

  <p class="cbt-viewer-summary">
    <strong data-role="visible-count">{rows.length}</strong> of <strong>{rows.length}</strong> programs
    shown.
  </p>

  <div class="cbt-viewer-table-wrap">
    <table>
      <thead>
        <tr>
          <th>Program</th>
          <th>Condition</th>
          <th>Modules</th>
          <th>Languages</th>
          <th>Lineage</th>
          <th>Status</th>
          <th>Viewer</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr
            data-row
            data-id={row.id}
            data-condition={row.condition}
            data-default-language={row.defaultLanguage}
            data-search={row.searchText}
            data-languages={row.languages.join(',')}
            data-translation-paths={JSON.stringify(row.translationPaths)}
          >
            <td>
              <a href={row.githubUrl} target="_blank" rel="noreferrer">
                {row.id}
              </a>
            </td>
            <td>{row.condition}</td>
            <td>{row.moduleCount}</td>
            <td>
              <div class="cbt-viewer-badges">
                {row.languages.map((lang) => (
                  <span class="cbt-badge">{lang}</span>
                ))}
              </div>
              <div class="cbt-viewer-meta">{row.translationSummary}</div>
            </td>
            <td>
              <div class="cbt-viewer-badges">
                {row.lineage.length > 0 ? (
                  row.lineage.map((label) => <span class="cbt-badge cbt-badge-lineage">{label}</span>)
                ) : (
                  <span class="cbt-viewer-meta">No lineage labels</span>
                )}
              </div>
            </td>
            <td>
              <span class="cbt-badge cbt-badge-status">{row.status}</span>
              <div class="cbt-viewer-meta">v{row.version}</div>
            </td>
            <td>
              <button type="button" class="cbt-open-button" data-role="open-reader">
                Read program
              </button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="cbt-viewer-empty cbt-viewer-meta" data-role="empty" hidden>
    No programs matched your current search/filter.
  </p>

  <section class="cbt-program-reader" data-role="reader" hidden>
    <div class="cbt-reader-header">
      <div>
        <h3 class="cbt-reader-title" data-role="reader-title">Program reader</h3>
        <p class="cbt-viewer-meta" data-role="reader-subtitle"></p>
      </div>
      <div class="cbt-reader-controls">
        <label class="cbt-viewer-meta">
          Language
          <select data-role="reader-language"></select>
        </label>
        <a data-role="reader-source" href="#" target="_blank" rel="noreferrer">
          Open locale JSON
        </a>
      </div>
    </div>
    <p class="cbt-viewer-meta" data-role="reader-status"></p>
    <p data-role="reader-summary"></p>
    <div data-role="reader-modules"></div>
    <div data-role="reader-resources"></div>
    <div data-role="reader-ai"></div>
  </section>
</div>

<script is:inline>
  (() => {
    const initViewer = (root) => {
      if (!root) return;

      const searchInput = root.querySelector('[data-role="search"]');
      const languageSelect = root.querySelector('[data-role="language"]');
      const countEl = root.querySelector('[data-role="visible-count"]');
      const emptyEl = root.querySelector('[data-role="empty"]');
      const rows = Array.from(root.querySelectorAll('tr[data-row]'));
      const openButtons = Array.from(root.querySelectorAll('[data-role="open-reader"]'));
      const reader = root.querySelector('[data-role="reader"]');
      const readerTitle = root.querySelector('[data-role="reader-title"]');
      const readerSubtitle = root.querySelector('[data-role="reader-subtitle"]');
      const readerLanguage = root.querySelector('[data-role="reader-language"]');
      const readerSource = root.querySelector('[data-role="reader-source"]');
      const readerStatus = root.querySelector('[data-role="reader-status"]');
      const readerSummary = root.querySelector('[data-role="reader-summary"]');
      const readerModules = root.querySelector('[data-role="reader-modules"]');
      const readerResources = root.querySelector('[data-role="reader-resources"]');
      const readerAi = root.querySelector('[data-role="reader-ai"]');

      let activeRow = null;

    const createSectionList = (title, items) => {
      if (!Array.isArray(items) || items.length === 0) return null;
      const wrap = document.createElement('div');
      wrap.className = 'cbt-reader-list';
      const heading = document.createElement('h5');
      heading.textContent = title;
      const list = document.createElement('ul');
      items.forEach((item) => {
        const li = document.createElement('li');
        li.textContent = String(item);
        list.appendChild(li);
      });
      wrap.appendChild(heading);
      wrap.appendChild(list);
      return wrap;
    };

    const renderProgram = (data, languageCode) => {
      if (!readerSummary || !readerModules || !readerResources || !readerAi || !readerStatus) return;

      readerSummary.textContent = data.summary || 'No summary available for this locale.';
      readerModules.innerHTML = '';
      readerResources.innerHTML = '';
      readerAi.innerHTML = '';

      const modules = Array.isArray(data.modules) ? data.modules : [];
      readerStatus.textContent = `Loaded ${languageCode} locale • ${modules.length} module(s).`;

      if (modules.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'cbt-viewer-meta';
        empty.textContent = 'No module content found in this locale file.';
        readerModules.appendChild(empty);
      } else {
        modules.forEach((module, index) => {
          const details = document.createElement('details');
          details.className = 'cbt-reader-module';
          if (index === 0) details.open = true;

          const summary = document.createElement('summary');
          const moduleTitle = module.title || module.id || `Module ${index + 1}`;
          summary.textContent = `${index + 1}. ${moduleTitle}`;
          details.appendChild(summary);

          if (module.overview) {
            const overview = document.createElement('p');
            overview.textContent = String(module.overview);
            details.appendChild(overview);
          }

          const takeaways = createSectionList('Takeaways', module.takeaways);
          const exercises = createSectionList('Exercises', module.exercises);
          const homework = createSectionList('Homework', module.homework);
          [takeaways, exercises, homework].forEach((section) => {
            if (section) details.appendChild(section);
          });

          readerModules.appendChild(details);
        });
      }

      if (Array.isArray(data.resources) && data.resources.length > 0) {
        const wrap = document.createElement('div');
        wrap.className = 'cbt-reader-list';
        const heading = document.createElement('h4');
        heading.textContent = 'Resources';
        wrap.appendChild(heading);

        const list = document.createElement('ul');
        data.resources.forEach((resource) => {
          const li = document.createElement('li');
          if (resource && resource.url) {
            const link = document.createElement('a');
            link.href = String(resource.url);
            link.target = '_blank';
            link.rel = 'noreferrer';
            link.textContent = resource.title ? String(resource.title) : String(resource.url);
            li.appendChild(link);
          } else {
            li.textContent = resource?.title ? String(resource.title) : 'Unnamed resource';
          }
          list.appendChild(li);
        });

        wrap.appendChild(list);
        readerResources.appendChild(wrap);
      }

      if (data.aiSupport) {
        const wrap = document.createElement('div');
        wrap.className = 'cbt-reader-ai-card';
        const heading = document.createElement('h4');
        heading.textContent = 'AI support profile';
        wrap.appendChild(heading);

        const tone = document.createElement('p');
        const toneLabel = document.createElement('strong');
        toneLabel.textContent = 'Tone: ';
        tone.appendChild(toneLabel);
        tone.appendChild(document.createTextNode(String(data.aiSupport.coachingTone || 'N/A')));
        const prompt = document.createElement('p');
        const promptLabel = document.createElement('strong');
        promptLabel.textContent = 'System prompt: ';
        prompt.appendChild(promptLabel);
        prompt.appendChild(document.createTextNode(String(data.aiSupport.systemPrompt || 'N/A')));
        wrap.appendChild(tone);
        wrap.appendChild(prompt);
        readerAi.appendChild(wrap);
      }
    };

    const parseRowData = (row) => {
      const translationPathsRaw = row.getAttribute('data-translation-paths') || '{}';
      let translationPaths = {};
      try {
        translationPaths = JSON.parse(translationPathsRaw);
      } catch {
        translationPaths = {};
      }
      const languages = (row.getAttribute('data-languages') || '')
        .split(',')
        .map((lang) => lang.trim())
        .filter(Boolean);
      return {
        id: row.getAttribute('data-id') || 'unknown-program',
        condition: row.getAttribute('data-condition') || 'Unknown condition',
        defaultLanguage: row.getAttribute('data-default-language') || languages[0] || 'en',
        translationPaths,
        languages,
      };
    };

    const loadLocale = async (rowData, languageCode) => {
      if (!readerStatus || !readerSource) return;

      const pathFromMeta =
        rowData.translationPaths[languageCode] || `locales/${languageCode}.json`;
      const rawUrl =
        `https://raw.githubusercontent.com/eir-space/eir-open/main/` +
        `skills/cbt-programs/data/programs/${rowData.id}/${pathFromMeta}`;

      readerStatus.textContent = `Loading ${languageCode} locale...`;
      readerSource.href = rawUrl;

      try {
        const response = await fetch(rawUrl);
        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }
        const data = await response.json();
        renderProgram(data, languageCode);
      } catch (error) {
        if (readerSummary) readerSummary.textContent = '';
        if (readerModules) readerModules.innerHTML = '';
        if (readerResources) readerResources.innerHTML = '';
        if (readerAi) readerAi.innerHTML = '';
        readerStatus.textContent =
          `Could not load locale file (${languageCode}). ${String(error && error.message ? error.message : error)}`;
      }
    };

      const applyFilters = () => {
        const query = (searchInput?.value || '').toLowerCase().trim();
        const language = (languageSelect?.value || 'all').toLowerCase();
        let visible = 0;

      rows.forEach((row) => {
        const rowSearch = (row.getAttribute('data-search') || '').toLowerCase();
        const rowLanguages = (row.getAttribute('data-languages') || '').toLowerCase().split(',');
        const matchesQuery = !query || rowSearch.includes(query);
        const matchesLanguage = language === 'all' || rowLanguages.includes(language);
        const show = matchesQuery && matchesLanguage;
        row.hidden = !show;
        if (show) visible += 1;
        });

        if (countEl) countEl.textContent = String(visible);
        if (emptyEl) emptyEl.hidden = visible !== 0;
      };

    openButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const row = button.closest('tr[data-row]');
        if (!row || !reader || !readerTitle || !readerSubtitle || !readerLanguage) return;

        rows.forEach((otherRow) => otherRow.classList.remove('cbt-row-selected'));
        row.classList.add('cbt-row-selected');
        activeRow = row;

        const rowData = parseRowData(row);
        const languageSet = new Set([
          ...rowData.languages,
          ...Object.keys(rowData.translationPaths || {}),
          rowData.defaultLanguage,
        ]);
        const languages = Array.from(languageSet).filter(Boolean).sort();

        readerTitle.textContent = rowData.id;
        readerSubtitle.textContent = rowData.condition;
        reader.hidden = false;

        readerLanguage.innerHTML = '';
        languages.forEach((lang) => {
          const option = document.createElement('option');
          option.value = lang;
          option.textContent = lang;
          readerLanguage.appendChild(option);
        });

        const selectedLang = languages.includes(rowData.defaultLanguage)
          ? rowData.defaultLanguage
          : languages[0] || 'en';
        readerLanguage.value = selectedLang;
        loadLocale(rowData, selectedLang);
      });
    });

    readerLanguage?.addEventListener('change', () => {
      if (!activeRow) return;
      const rowData = parseRowData(activeRow);
      loadLocale(rowData, readerLanguage.value || rowData.defaultLanguage || 'en');
    });

      searchInput?.addEventListener('input', applyFilters);
      languageSelect?.addEventListener('change', applyFilters);
      applyFilters();
    };

    const boot = () => {
      const viewerRoots = Array.from(document.querySelectorAll('[data-cbt-program-viewer]'));
      viewerRoots.forEach((viewerRoot) => initViewer(viewerRoot));
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    } else {
      boot();
    }
  })();
</script>

<style>
  .cbt-viewer-toolbar {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin: 0 0 0.7rem 0;
    align-items: flex-end;
  }

  .cbt-viewer-hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.7rem;
    margin: 0 0 0.8rem 0;
  }

  .cbt-viewer-stat {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.7rem;
    padding: 0.65rem 0.75rem;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--sl-color-bg) 86%, var(--sl-color-gray-7)),
      var(--sl-color-bg)
    );
  }

  .cbt-viewer-stat-value {
    display: block;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--sl-color-text-accent);
    line-height: 1.15;
  }

  .cbt-viewer-stat-label {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.78rem;
    color: var(--sl-color-gray-3);
  }

  .cbt-viewer-field {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
    min-width: 12rem;
    flex: 1 1 22rem;
  }

  .cbt-viewer-field-lang {
    flex: 0 0 14rem;
  }

  .cbt-viewer-toolbar input,
  .cbt-viewer-toolbar select {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    font: inherit;
    min-height: 2.5rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
  }

  .cbt-viewer-toolbar input:focus,
  .cbt-viewer-toolbar select:focus {
    outline: 2px solid color-mix(in srgb, var(--sl-color-accent) 45%, transparent);
    outline-offset: 0;
    border-color: color-mix(in srgb, var(--sl-color-accent) 45%, var(--sl-color-gray-5));
  }

  .cbt-viewer-summary {
    margin: 0 0 0.6rem 0;
    color: var(--sl-color-gray-2);
    font-size: 0.84rem;
  }

  .cbt-viewer-empty {
    margin-top: 0.7rem;
    padding: 0.65rem 0.75rem;
    border: 1px dashed var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--sl-color-bg) 90%, var(--sl-color-gray-7));
  }

  .cbt-viewer-table-wrap {
    overflow: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 76rem;
  }

  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.58rem 0.7rem;
    border-bottom: 1px solid var(--sl-color-gray-6);
  }

  th {
    position: sticky;
    top: 0;
    z-index: 1;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--sl-color-gray-2);
    background: var(--sl-color-gray-7);
    letter-spacing: 0.015em;
  }

  tr:last-child td {
    border-bottom: none;
  }

  tbody tr:nth-child(odd) td {
    background: color-mix(in srgb, var(--sl-color-bg) 94%, var(--sl-color-gray-7));
  }

  tbody tr:hover td {
    background: color-mix(in srgb, var(--sl-color-accent) 10%, var(--sl-color-bg));
  }

  .cbt-viewer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.35rem;
  }

  .cbt-badge {
    display: inline-block;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    padding: 0.08rem 0.44rem;
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--sl-color-gray-2);
    background: var(--sl-color-gray-7);
    white-space: nowrap;
  }

  .cbt-badge-lineage {
    border-color: color-mix(in srgb, var(--sl-color-accent) 35%, var(--sl-color-gray-5));
  }

  .cbt-badge-status {
    text-transform: lowercase;
    font-weight: 600;
  }

  .cbt-viewer-meta {
    font-size: 0.72rem;
    color: var(--sl-color-gray-3);
    line-height: 1.4;
  }

  .cbt-open-button {
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 45%, var(--sl-color-gray-5));
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--sl-color-accent) 16%, var(--sl-color-bg));
    color: var(--sl-color-text-accent);
    padding: 0.34rem 0.62rem;
    cursor: pointer;
    font: inherit;
    font-size: 0.76rem;
    font-weight: 600;
  }

  .cbt-open-button:hover {
    border-color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 26%, var(--sl-color-bg));
  }

  .cbt-row-selected td {
    background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
  }

  .cbt-program-reader {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    padding: 1rem;
    margin-top: 1rem;
    background: color-mix(in srgb, var(--sl-color-bg) 95%, var(--sl-color-gray-7));
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
  }

  .cbt-reader-header {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .cbt-reader-title {
    margin: 0;
    font-size: 1.15rem;
  }

  .cbt-reader-controls {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .cbt-reader-controls select {
    margin-left: 0.35rem;
    border: 1px solid var(--sl-color-gray-5);
