---
import ThemeToggle from '@/components/ThemeToggle.astro';

const { current = '' } = Astro.props as { current?: 'home' | 'docs' | 'blog' | 'ranking' | '' };

const navItems = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/docs/', label: 'Docs', key: 'docs' },
  { href: '/blog/', label: 'Blog', key: 'blog' },
  { href: '/docs/ai-compute-disease-ranking/', label: 'Ranking', key: 'ranking' },
] as const;
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="brand-lockup" href="/" aria-label="Eir Open home">
      <img src="/brand/eir-rune.svg" alt="" width="40" height="40" />
      <div class="brand-copy">
        <span class="brand-name">Eir Open</span>
        <span class="brand-domain">open.eir.space</span>
      </div>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {navItems.map((item) => (
        <a class:list={['nav-link', current === item.key && 'is-active']} href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    padding-top: 1rem;
  }

  .site-header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    border: 1px solid color-mix(in srgb, var(--border-subtle) 75%, transparent);
    border-radius: 1.35rem;
    background: color-mix(in srgb, var(--card) 82%, transparent);
    box-shadow: var(--card-shadow);
    backdrop-filter: blur(16px);
    padding: 0.8rem 1rem;
  }

  .brand-lockup {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .brand-lockup img {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.85rem;
    box-shadow: 0 10px 24px -16px rgba(30, 148, 168, 0.8);
  }

  .brand-copy {
    display: grid;
    gap: 0.1rem;
  }

  .brand-name {
    color: var(--foreground);
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .brand-domain {
    color: var(--muted-foreground);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .header-actions {
    display: flex;
    justify-content: flex-end;
  }

  .nav-link {
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--muted-foreground);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.55rem 0.9rem;
    text-decoration: none;
    transition:
      color var(--dur-base) ease,
      background var(--dur-base) ease,
      border-color var(--dur-base) ease;
  }

  .nav-link:hover,
  .nav-link.is-active {
    border-color: color-mix(in srgb, var(--primary) 30%, transparent);
    background: color-mix(in srgb, var(--primary) 18%, transparent);
    color: var(--foreground);
  }

  @media (max-width: 800px) {
    .site-header {
      width: min(100% - 1rem, 1180px);
      padding-top: 0.75rem;
    }

    .site-header-inner {
      grid-template-columns: 1fr;
      border-radius: 1.1rem;
      padding: 0.85rem;
    }

    .site-nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .header-actions {
      justify-content: center;
    }

    .nav-link {
      text-align: center;
    }
  }
</style>
