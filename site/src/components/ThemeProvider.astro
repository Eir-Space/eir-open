{/* Default to light theme and keep dataset/color-scheme in sync before paint */}
<script is:inline>
	window.StarlightThemeProvider = (() => {
		let storedTheme =
			typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
		if (!storedTheme) {
			storedTheme = 'light';
			if (typeof localStorage !== 'undefined') localStorage.setItem('starlight-theme', 'light');
		}
		const theme = storedTheme === 'dark' ? 'dark' : 'light';
		document.documentElement.dataset.theme = theme;
		document.documentElement.style.colorScheme = theme;
		return {
			updatePickers(theme = storedTheme || 'light') {
				document.querySelectorAll('theme-toggle').forEach((picker) => {
					picker.setAttribute('data-theme', theme === 'dark' ? 'dark' : 'light');
				});
			},
		};
	})();
</script>
