---
import '@/styles/global.css';
import ThemeProvider from '@/components/ThemeProvider.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs
    .map((doc) => ({
      doc,
      slug: doc.id.replace(/\.(md|mdx)$/i, '').replace(/\/index$/i, '').replace(/^index$/i, ''),
    }))
    .filter(({ slug }) => slug && slug !== 'ai-compute-disease-ranking')
    .map(({ doc, slug }) => ({
      params: { slug },
      props: { doc },
    }));
}

const rawSlug = Astro.params.slug;
const slug = Array.isArray(rawSlug) ? rawSlug.join('/') : rawSlug || '';
const { doc } = Astro.props;
if (typeof Astro.locals.t !== 'function') {
  Astro.locals.t = (key: string) => key;
}
const { Content } = await render(doc);
const title = doc.data.title || 'Documentation page';
const description = doc.data.description || 'Project documentation for Eir Open.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Eir Open</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#111110" />
  </head>
  <body>
    <ThemeProvider />
    <SiteHeader current="docs" />
    <main class="doc-shell">
      <article class="doc-card">
        <a class="back-link" href="/docs/">Back to docs</a>
        <p class="eyebrow">Documentation</p>
        <h1>{title}</h1>
        <p class="doc-description">{description}</p>
        <div class="doc-body">
          <Content />
        </div>
      </article>
    </main>
  </body>
</html>

<style>
  .doc-shell {
    width: min(100% - 1rem, 980px);
    margin: 0 auto;
    padding: 1.25rem 0 4rem;
  }

  .doc-card {
    width: 100%;
    border: 1px solid var(--border-subtle);
    border-radius: 1.75rem;
    background:
      radial-gradient(circle at top right, rgba(139, 184, 206, 0.14), transparent 24%),
      color-mix(in srgb, var(--card) 95%, white 5%);
    box-shadow: var(--card-shadow);
    padding: 2.2rem;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 1rem;
    color: var(--muted-foreground);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .eyebrow {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.8rem 0 0;
    font-size: clamp(2rem, 6vw, 4rem);
    line-height: 1;
  }

  .doc-description {
    margin-top: 1rem;
    color: var(--muted-foreground);
    line-height: 1.75;
  }

  .doc-body {
    margin-top: 2rem;
  }

  .doc-body :global(p),
  .doc-body :global(li),
  .doc-body :global(td),
  .doc-body :global(th) {
    color: var(--foreground);
    font-size: 1rem;
    line-height: 1.8;
  }

  .doc-body :global(h2) {
    margin: 2.25rem 0 0.85rem;
    font-size: 1.75rem;
    line-height: 1.15;
  }

  .doc-body :global(h3) {
    margin: 1.75rem 0 0.7rem;
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .doc-body :global(a) {
    color: var(--primary);
  }

  .doc-body :global(code) {
    background: var(--background-soft);
    border: 1px solid var(--border-subtle);
    border-radius: 0.55rem;
    padding: 0.12rem 0.35rem;
  }

  .doc-body :global(pre) {
    overflow-x: auto;
    border: 1px solid var(--border-subtle);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--background-soft) 88%, black 12%);
    padding: 1rem;
  }

  .doc-body :global(pre code) {
    background: transparent;
    border: 0;
    padding: 0;
  }

  .doc-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }

  .doc-body :global(th),
  .doc-body :global(td) {
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.75rem 0.5rem;
    text-align: left;
    vertical-align: top;
  }

  .doc-body :global(.section-divider) {
    border: 0;
    border-top: 1px solid var(--border-subtle);
    margin: 2rem 0;
  }

  .doc-body :global(.starlight-aside) {
    margin: 1.25rem 0;
  }

  .doc-body :global(.not-content) {
    margin: 1.25rem 0;
  }

  @media (max-width: 800px) {
    .doc-shell {
      padding-top: 0.85rem;
    }

    .doc-card {
      border-radius: 1.25rem;
      padding: 1.25rem;
    }

    .doc-body :global(table) {
      display: block;
      overflow-x: auto;
    }
  }
 </style>
