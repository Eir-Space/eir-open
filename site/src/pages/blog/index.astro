---
import '@/styles/global.css';
import ThemeProvider from '@/components/ThemeProvider.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => (import.meta.env.PROD ? data.draft !== true : true)))
  .sort((left, right) => right.data.pubDate.getTime() - left.data.pubDate.getTime());

const postHref = (id: string) => `/blog/${id.replace(/\.(md|mdx)$/, '')}/`;

const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const otherPosts = posts.filter((post) => post.id !== featuredPost?.id);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog | Eir Open</title>
    <meta
      name="description"
      content="Essays and working notes on health AI, computational medicine, and where large-scale inference actually helps."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#111110" />
  </head>
  <body>
    <ThemeProvider />
    <SiteHeader current="blog" />
    <main class="blog-shell">
      <section class="blog-hero">
        <p class="eyebrow">Eir Open Blog</p>
        <h1>Field notes on AI, medicine, and the shape of hard health problems.</h1>
        <p class="hero-copy">
          Essays and arguments about how Eir sees the future of healthcare:
          more patient agency, better health tools, private-by-default systems, and a healthcare stack built around people being able to understand and act on their own data.
        </p>
        <div class="hero-actions">
          <a class="primary" href="/docs/computational-view-of-medicine/">Read the white paper</a>
          <a href="/docs/ai-compute-disease-ranking/">View the ranking</a>
        </div>
      </section>

      {featuredPost && (
        <section>
          <p class="section-label">Featured post</p>
          <a class="featured-post" href={postHref(featuredPost.id)}>
            <div class="featured-meta">
              <span>{featuredPost.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
              <span>{featuredPost.data.author}</span>
            </div>
            <h2>{featuredPost.data.title}</h2>
            <p>{featuredPost.data.description}</p>
            <div class="tag-row">
              {featuredPost.data.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </a>
        </section>
      )}

      <section>
        <p class="section-label">All posts</p>
        <div class="post-grid">
          {otherPosts.map((post) => (
            <a class="post-card" href={postHref(post.id)}>
              <div class="post-meta">
                <span>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                <span>{post.data.author}</span>
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  .blog-shell {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.25rem 0 4rem;
  }

  .blog-hero {
    border: 1px solid var(--border-subtle);
    border-radius: 1.9rem;
    background:
      radial-gradient(circle at 85% 15%, rgba(232, 168, 48, 0.14), transparent 28%),
      linear-gradient(180deg, color-mix(in srgb, var(--card) 94%, white 6%), var(--card));
    box-shadow: var(--card-shadow);
    padding: 2.6rem;
  }

  .eyebrow,
  .section-label {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.9rem 0 0;
    max-width: 12ch;
    font-size: clamp(2.6rem, 7vw, 4.8rem);
    line-height: 0.96;
  }

  .hero-copy {
    max-width: 48rem;
    margin: 1rem 0 0;
    color: var(--muted-foreground);
    line-height: 1.8;
    font-size: 1.02rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.5rem;
  }

  .hero-actions a {
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 0.8rem 1.05rem;
    background: var(--card);
    color: var(--foreground);
    font-weight: 600;
    text-decoration: none;
  }

  .hero-actions .primary {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--primary-foreground);
  }

  section + section {
    margin-top: 1.8rem;
  }

  .featured-post,
  .post-card {
    display: block;
    border: 1px solid var(--border-subtle);
    border-radius: 1.5rem;
    background: var(--card);
    box-shadow: var(--card-shadow);
    color: inherit;
    text-decoration: none;
  }

  .featured-post {
    padding: 1.6rem;
  }

  .featured-post h2,
  .post-card h2 {
    margin: 0.75rem 0 0;
    font-size: 1.65rem;
    line-height: 1.15;
  }

  .featured-post p,
  .post-card p {
    margin: 0.85rem 0 0;
    color: var(--muted-foreground);
    line-height: 1.75;
  }

  .featured-meta,
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    color: var(--muted-foreground);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .tag-row span {
    border-radius: 999px;
    background: var(--background-soft);
    padding: 0.45rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .post-card {
    padding: 1.3rem;
  }

  @media (max-width: 800px) {
    .blog-shell {
      width: min(100% - 1rem, 1120px);
      padding-top: 0.85rem;
    }

    .blog-hero {
      padding: 1.5rem;
      border-radius: 1.3rem;
    }

    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
