---
import '@/styles/global.css';
import ThemeProvider from '@/components/ThemeProvider.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import ComputationalMedicineBrief from '@/components/ComputationalMedicineBrief.astro';
import WhitePaperCallout from '@/components/WhitePaperCallout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => (import.meta.env.PROD ? data.draft !== true : true));
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const showComputationalBrief = post.id.replace(/\.(md|mdx)$/, '') === 'computational-view-of-disease';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.data.title} | Eir Open Blog</title>
    <meta name="description" content={post.data.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#111110" />
  </head>
  <body>
    <ThemeProvider />
    <SiteHeader current="blog" />
    <main class="post-shell">
      <a class="back-link" href="/blog/">Back to blog</a>
      <article class="post-card">
        <header class="post-header">
          <p class="eyebrow">Eir Open Blog</p>
          <h1>{post.data.title}</h1>
          <p class="dek">{post.data.description}</p>
          <div class="meta-row">
            <span>{post.data.author}</span>
            <span>{post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
          </div>
          <div class="tag-row">
            {post.data.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        </header>

        <div class="post-body">
          {showComputationalBrief && <WhitePaperCallout compact />}
          {showComputationalBrief && <ComputationalMedicineBrief />}
          <Content />
        </div>
      </article>
    </main>
  </body>
</html>

<style>
  .post-shell {
    width: min(860px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.25rem 0 4rem;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 1rem;
    color: var(--muted-foreground);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .post-card {
    border: 1px solid var(--border-subtle);
    border-radius: 1.9rem;
    background:
      radial-gradient(circle at top right, rgba(232, 168, 48, 0.12), transparent 28%),
      var(--card);
    box-shadow: var(--card-shadow);
    padding: 2.2rem;
  }

  .eyebrow {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.85rem 0 0;
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    line-height: 0.98;
  }

  .dek {
    margin: 1rem 0 0;
    max-width: 50rem;
    color: var(--muted-foreground);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1rem;
    color: var(--muted-foreground);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .tag-row span {
    border-radius: 999px;
    background: var(--background-soft);
    padding: 0.45rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .post-body {
    margin-top: 2rem;
  }

  .post-body :global(p),
  .post-body :global(li) {
    color: var(--foreground);
    font-size: 1.02rem;
    line-height: 1.85;
  }

  .post-body :global(h2) {
    margin: 2.2rem 0 0.8rem;
    font-size: 1.75rem;
    line-height: 1.15;
  }

  .post-body :global(ul) {
    padding-left: 1.25rem;
  }

  .post-body :global(strong) {
    color: var(--foreground);
  }

  @media (max-width: 800px) {
    .post-shell {
      width: min(100% - 1rem, 860px);
      padding-top: 0.85rem;
    }

    .post-card {
      border-radius: 1.35rem;
      padding: 1.4rem;
    }
  }
</style>
